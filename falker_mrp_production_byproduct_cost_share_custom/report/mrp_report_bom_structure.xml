<odoo>
    <template id="report_mrp_bom_inherit" inherit_id="mrp.report_mrp_bom">
        <!-- Add group restriction to Product Cost header -->
        <xpath expr="//th[@class='o_mrp_prod_cost text-right']" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to BoM Cost header -->
        <xpath expr="//th[@class='o_mrp_bom_cost text-right']" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to Product Cost cell in table body -->
        <xpath expr="//td[@class='o_mrp_prod_cost text-right']" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to BoM Cost cell in table body -->
        <xpath expr="//td[@class='o_mrp_bom_cost text-right']" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to Unit Cost label in table footer (BOM line) -->
        <xpath expr="//tfoot/tr[@class='o_mrp_prod_cost']/td[3]" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to Product Cost value cell in table footer (BOM line) -->
        <xpath expr="//tfoot/tr[@class='o_mrp_prod_cost']/td[5]" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to BoM Cost cell in table footer (BOM line) -->
        <xpath expr="//tfoot/tr[@class='o_mrp_prod_cost']/td[6]" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to Unit Cost label in table footer (By-Product lines) -->
        <xpath expr="//tfoot//tr[@class='o_mrp_bom_cost']//td[3]" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to Product Cost value cell in table footer (By-Product lines) -->
        <xpath expr="//tfoot//tr[@class='o_mrp_bom_cost']//td[5]" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>

        <!-- Add group restriction to BoM Cost cell in table footer (By-Product lines) -->
        <xpath expr="//tfoot//tr[@class='o_mrp_bom_cost']//td[6]" position="attributes">
            <attribute
                name="groups"
            >falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info</attribute>
        </xpath>
    </template>

    <!-- BOM line template (components) - inside t-foreach -->
    <template id="report_mrp_bom_line_inherit" inherit_id="mrp.report_mrp_bom_line">
        <!-- Add t-if condition to Product Cost cell for group restriction -->
        <xpath expr="//td[@class='o_mrp_prod_cost text-right']" position="attributes">
            <attribute
                name="t-if"
            >env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>

        <!-- Add t-if condition to BoM Cost cell for group restriction -->
        <xpath expr="//td[@class='o_mrp_bom_cost text-right']" position="attributes">
            <attribute
                name="t-if"
            >env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>

        <!-- Add t-if condition to empty Product Cost cell for operations -->
        <xpath
            expr="//tr[contains(@class, 'o_mrp_bom_report_line') and contains(@class, 'o_mrp_bom_cost')]/td[5]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>
    </template>

    <!-- Operation line template - inside t-foreach -->
    <template
        id="report_mrp_operation_line_inherit"
        inherit_id="mrp.report_mrp_operation_line"
    >
        <!-- Add t-if condition to Product Cost cell for group restriction -->
        <xpath
            expr="//td[contains(@class, 'text-right') and span[@t-options]]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>

        <!-- Add t-if condition to BoM Cost cell for group restriction -->
        <xpath
            expr="//td[contains(@class, 'text-right') and position()=6]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>
    </template>

    <!-- PDF line template - inside t-foreach -->
    <template
        id="report_mrp_bom_pdf_line_inherit"
        inherit_id="mrp.report_mrp_bom_pdf_line"
    >
        <!-- Add t-if condition to Product Cost cell for group restriction -->
        <xpath expr="//td[@class='o_mrp_prod_cost text-right']" position="attributes">
            <attribute
                name="t-if"
            >data['report_structure'] != 'bom_structure' and env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>

        <!-- Add t-if condition to BoM Cost cell for group restriction -->
        <xpath expr="//td[@class='o_mrp_bom_cost text-right']" position="attributes">
            <attribute
                name="t-if"
            >data['report_structure'] != 'bom_structure' and env.user.has_group('falker_mrp_production_byproduct_cost_share_custom.group_falker_cost_info')</attribute>
        </xpath>
    </template>
</odoo>
