<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <record model="ir.actions.server" id="export_partner_to_mautic">
        <field name="name">Contact Export to mautic</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">if records:
        action = records.export_contact()
        </field>

    </record>
    <record model="ir.actions.server" id="export_partner_to_mautic_company">
        <field name="name">Company Export to mautic</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">if records:
        action = records.export_company()
        </field>

    </record>

    <record id="l10n_br_base_partner_form" model="ir.ui.view">
        <field name="name">l10n_br_base.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <page position="after" name="sales_purchases">
                <page
                    string="Mautic"
                    name="Mautic"
                    groups="mautic_connector.group_mautic_admin,mautic_connector.group_mautic_user"
                >
                    <group name="mautic">
                        <field name="mautic_id" />
                        <field name="mautic_exported" />
                        <field name="mautic_is_update" />
                        <field
                            name="mautic_custom_fields"
                            readonly="1"
                            nolabel="1"
                            style="white-space: pre-wrap;"
                        />
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
