<odoo>
  <record id="view_mautic_tag_tree" model="ir.ui.view">
    <field name="name">mautic.tag.tree</field>
    <field name="model">mautic.tag</field>
    <field name="arch" type="xml">
      <tree create="false">
        <field name="name_mautic" />
        <field name="external_id" />
        <field name="active" />
      </tree>
    </field>
  </record>

  <record id="view_mautic_tag_form" model="ir.ui.view">
    <field name="name">mautic.tag.form</field>
    <field name="model">mautic.tag</field>
    <field name="arch" type="xml">
      <form string="Tag">
        <sheet>
          <group>
            <field name="name_mautic" readonly="1" />
            <field name="external_id" readonly="1" />
          </group>
          <group>
            <field name="active" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_mautic_tag" model="ir.actions.act_window">
    <field name="name">Tags</field>
    <field name="res_model">mautic.tag</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_mautic_tag_tree" />
    <field name="context">{}</field>
    <field name="target">current</field>
  </record>

</odoo>
