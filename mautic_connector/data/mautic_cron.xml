<odoo>
  <record id="ir_cron_import_mautic_contacts" model="ir.cron">
    <field name="name">Import Mautic Contacts</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="state">code</field>
    <field name="code">model.search([]).import_contacts()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
    <field name="active">False</field>
  </record>

  <record id="ir_cron_update_mautic_contacts" model="ir.cron">
    <field name="name">Mautic: Update Contacts</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="state">code</field>
    <field name="code">model.search([]).update_contacts()</field>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active">Active</field>
  </record>

  <record id="ir_cron_import_mautic_companies" model="ir.cron">
    <field name="name">Import Mautic Companies</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="state">code</field>
    <field name="code">model.search([]).import_company()</field>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active">Active</field>
  </record>

  <record id="cron_export_company_to_mautic" model="ir.cron">
    <field name="name">Export Company to Mautic</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="state">code</field>
    <field name="code">model.cron_export_company_to_mautic()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active">False</field>
  </record>

  <record id="ir_cron_export_contacts_to_mautic" model="ir.cron">
        <field name="name">Export contacts to Mautic</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">model.cron_export_contacts_to_mautic()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
  </record>

  <record id="ir_cron_mautic_import_segments" model="ir.cron">
    <field name="name">Mautic: Importar Segmentos</field>
    <field name="model_id" ref="mautic_connector.model_mautic_segment" />
    <field name="state">code</field>
    <field name="code">model.import_segments()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>

  <record id="ir_cron_mautic_import_tags" model="ir.cron">
    <field name="name">Mautic: Importar Tags</field>
    <field name="model_id" ref="mautic_connector.model_mautic_tag" />
    <field name="state">code</field>
    <field name="code">model.import_tags()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">Active</field>
  </record>

</odoo>
