<odoo>
    <odoo>
        <record id="view_currency_rate_tree_inherit_purchase" model="ir.ui.view">
            <field name="name">res.currency.rate.tree.inherit.purchase</field>
            <field name="model">res.currency.rate</field>
            <field name="inherit_id" ref="base.view_currency_rate_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_rate']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='rate']" position="after">
                    <field name="rate_purchase" digits="[12,12]" />
                    <field name="rate" string="Sale Rate (BCB)" digits="[12,12]" />
                </xpath>
            </field>
        </record>
    </odoo>

    <record id="action_currency_rate_custom" model="ir.actions.act_window">
        <field name="name">Currency Rate</field>
        <field name="res_model">res.currency.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem
        id="menu_currency_rate_custom"
        parent="account.account_account_menu"
        action="action_currency_rate_custom"
        sequence="40"
    />
</odoo>
