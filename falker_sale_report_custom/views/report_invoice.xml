<odoo>

    <template
        id="tax_groups_totals"
        name="falker_tax_groups_totals_custom"
        inherit_id="account.tax_groups_totals"
    >
        <xpath expr="//t[@t-as='amount_by_group']/tr" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//t[@t-as='amount_by_group']" position="inside">
            <tr
                t-if="'IBS' not in amount_by_group['tax_group_name'] and 'CBS' not in amount_by_group['tax_group_name']"
            >
                <td>
                    <span class="text-nowrap">
                        <span t-esc="amount_by_group['tax_group_name']" />
                        <t t-if="'IPI' not in amount_by_group['tax_group_name']">
                            <span> Incluso</span>
                        </t>
                    </span>
                </td>
                <td class="text-end o_price_total">
                    <span
                        class="text-nowrap"
                        t-esc="amount_by_group['formatted_tax_group_amount']"
                    />
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
